// ClaimPilot reference gateway config (OpenClaw, JSON5).
// Reflects the deployment lessons in the README: all live agents on a tool-compatible
// cheap model; gateway.mode is required; models must be declared under models.providers.
{
  $schema: "https://docs.openclaw.ai/schema/openclaw.schema.json",
  gateway: { mode: "local", port: 19789, bind: "loopback",
             auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" }, reload: { mode: "hybrid" } },
  agents: {
    defaults: {
      workspace: "~/openclaw-insurance/workspace",
      model: { primary: "openai/gpt-5-mini" },
      models: { "openai/gpt-5-mini": { alias: "cheap" }, "openai/gpt-5.5": { alias: "frontier" } }
    },
    list: [
      { id: "main", default: true },
      { id: "intake",               workspace: "~/openclaw-insurance/workspace/agents/intake",               model: { primary: "openai/gpt-5-mini" } },
      { id: "doc-extractor",        workspace: "~/openclaw-insurance/workspace/agents/doc-extractor",        model: { primary: "openai/gpt-5-mini" } },
      { id: "policy-matcher",       workspace: "~/openclaw-insurance/workspace/agents/policy-matcher",       model: { primary: "openai/gpt-5-mini" } },
      { id: "medical-necessity",    workspace: "~/openclaw-insurance/workspace/agents/medical-necessity",    model: { primary: "openai/gpt-5-mini" } },
      { id: "fraud-anomaly",        workspace: "~/openclaw-insurance/workspace/agents/fraud-anomaly",        model: { primary: "openai/gpt-5-mini" } },
      { id: "notifier",             workspace: "~/openclaw-insurance/workspace/agents/notifier",             model: { primary: "openai/gpt-5-mini" } },
      { id: "audit-logger",         workspace: "~/openclaw-insurance/workspace/agents/audit-logger",         model: { primary: "openai/gpt-5-mini" } },
      { id: "pattern-review",       workspace: "~/openclaw-insurance/workspace/agents/pattern-review",       model: { primary: "openai/gpt-5.5" } }
    ]
  },
  models: { providers: { openai: { apiKey: "${OPENAI_API_KEY}", models: [ { id: "gpt-5-mini" }, { id: "gpt-5.5" } ] } } },
  cron: { enabled: true, maxConcurrentRuns: 1, sessionRetention: "24h" },
  session: { reset: { mode: "daily", atHour: 4 } }
}
