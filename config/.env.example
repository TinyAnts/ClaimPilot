# Rename to .env ON THE UDOO and fill. chmod 600. Never transfer this back filled.
# OpenClaw loads ~/openclaw-insurance/.env via the start script (set -a; source).

# OpenAI — all agents use this one key
OPENAI_API_KEY=sk-REPLACE_ME

# Gateway auth token — generate on the box:  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=REPLACE_ME

# Telegram (Step 6) — @BotFather for the token, @userinfobot for your id
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_ALLOW_ID=REPLACE_ME
